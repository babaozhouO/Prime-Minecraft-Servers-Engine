<Button xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="using:PMCSsE_Frontend_AvaloniaUI.Controls"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="35" d:DesignHeight="35"
		x:Class="PMCSsE_Frontend_AvaloniaUI.Controls.ImageButton" x:DataType="local:ImageButton"
		CornerRadius="4" BorderBrush="#FF04C7E0" BorderThickness="3" Name="root">

	<Image Margin="1" Source="{Binding #root.Image_IB}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

	<Button.Styles>
		<Style Selector="local|ImageButton">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
			<Setter Property="Background" Value="white"/>
		</Style>

		<Style Selector="local|ImageButton:pointerover">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
			<Setter Property="Background" Value="#807DA4C4"/>
		</Style>
    <Style Selector="local|MyButton:disabled">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
        <Setter Property="Background" Value="gray"/>
		</Style>

		<Style Selector="local|ImageButton:pressed">
			<Setter Property="Transitions">
				<Transitions>
					<ThicknessTransition Property="Margin" Duration="0:0:0.1"/>
				</Transitions>
			</Setter>
			<Setter Property="Margin" Value="2"/>
		</Style>
	</Button.Styles>
</Button>
