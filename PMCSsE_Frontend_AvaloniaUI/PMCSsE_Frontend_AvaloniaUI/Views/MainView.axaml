<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avaloniaedit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:controls="using:PMCSsE_Frontend_AvaloniaUI.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:vm="using:PMCSsE_Frontend_AvaloniaUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PMCSsE_Frontend_AvaloniaUI.Views.MainView"
             Name="root" x:DataType="vm:MainViewModel" Foreground="Black">
    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Panel>
        <Image Stretch="UniformToFill" Opacity="0.9" Source="avares://PMCSsE_Frontend_AvaloniaUI/Images/Background.png">
            <Image.Effect>
                <BlurEffect Radius="6"/>
            </Image.Effect>
        </Image>
        <TabControl Padding="0" SelectedIndex="{Binding FirstTabControlPage}">
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="60">
                        <TextBlock Classes="fir" Text="连接"/>
                        <Image Classes="fir" Source="{Binding ConnectionStateImage}"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <TabControl Classes="sec" SelectedIndex="{Binding ConnectPageIndex}">
                        <TabItem Header="添加" Classes="sec">
                            <Grid RowDefinitions="25,27,*,27,*,27,*,45,5"
                                  ColumnDefinitions="80,*,100">
                                <Line Classes="sec" Grid.RowSpan="9"/>
                                <TextBlock Grid.ColumnSpan="2" Text="后端信息" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                <Line Classes="fir" Grid.ColumnSpan="3" VerticalAlignment="Bottom"/>

                                <TextBlock Grid.Row="1" Text="主机名/IP:"/>
                                <TextBox Grid.Row="1" Text="{Binding DisplayingIP}"/>
                                <Line Grid.Row="1" Classes="tbul"/>

                                <TextBlock Grid.Row="3" Text="端口号:"/>
                                <TextBox Grid.Row="3" Text="{Binding DisplayingPort}"/>
                                <Line Grid.Row="3" Classes="tbul"/>

                                <TextBlock Grid.Row="5" Text="访问密钥:"/>
                                <TextBox Grid.Row="5" Text="{Binding DisplayingPassword}" PlaceholderText="（可选）" RevealPassword="True" PasswordChar="*"/>
                                <Line Grid.Row="5" Classes="tbul"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="不推荐保存密钥（明文）" Foreground="Red" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                                <controls:MyButton Grid.Column="2" Grid.Row="7" Text="添加" Command="{Binding AddNewBackendCommand}" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Finish.png"/>
                                <Grid.Styles>
                                    <Style Selector="Line.tbul">
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="StartPoint" Value="0,0"/>
                                        <Setter Property="EndPoint" Value="1,0"/>
                                        <Setter Property="Stretch" Value="Fill"/>
                                        <Setter Property="Stroke" Value="SkyBlue"/>
                                        <Setter Property="StrokeThickness" Value="2"/>
                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                    </Style>
                                    <Style Selector="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                    <Style Selector="TextBox">
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                    </Style>
                                </Grid.Styles>
                            </Grid>
                        </TabItem>
                        <TabItem Header="后端列表" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                                <ListBox Margin="7,5,0,5"  Background="Transparent" ItemsSource="{Binding Histories_IS}" BorderThickness="0" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible" >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:ConnectHistory_LBItem
                                                ConnectCommand="{Binding $parent[ListBox].((vm:MainViewModel)DataContext).ConnectCommand}"
                                                MyNativeServerHistory="{Binding MyNativeServerHistory}"
                                                DisplayText="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="1"/>
                                        </Style>
                                        <Style Selector="controls|ConnectHistory_LBItem">
                                            <Setter Property="Height" Value="60"/>
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                            </Panel>
                        </TabItem>
                        <TabItem Header="连接日志" Classes="sec">
                            <Grid ColumnDefinitions="2,5,65,*,5,140,5,100" RowDefinitions="5,*,5,40,5">
                                <Line Classes="sec" Grid.RowSpan="4"/>
                                <TextBox IsReadOnly="True" Text="{Binding ConnectLogs}" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="9"/>
                                <TextBlock Text="访问密钥:" IsVisible="{Binding PasswordEnterControlVisibility}" Grid.Column="2" Grid.Row="3" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Password}" RevealPassword="True" PasswordChar="*" IsVisible="{Binding PasswordEnterControlVisibility}" Grid.Column="3" Grid.Row="3" VerticalAlignment="Center"/>
                                <controls:MyButton Grid.Column="5" Grid.Row="3" Text="RSA公钥一致" Command="{Binding VerifyCommand}" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Login.png"/>
                                <controls:MyButton Grid.Column="5" Grid.Row="3" Text="确认访问密钥" Command="{Binding SendPasswordCommand}" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Login.png"/>
                                <controls:MyButton Grid.Column="7" Grid.Row="3" Text="断开连接" Command="{Binding DisconnectCommand}" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Unlink.png"/>

                            </Grid>
                        </TabItem>
                    </TabControl>
                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="80">
                        <TextBlock Classes="fir" Text="仪表盘"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/About.png"/>
                    </Panel>
                </TabItem.Header>

                <Panel>
                    <Line Classes="fir"/>
                    <TabControl Classes="sec" Padding="12,0,0,0">
                        <TabItem Header="系统状态" Classes="sec">
                            <ScrollViewer>
                                <Panel>
                                    <Line Classes="sec"/>
                                    <Grid Height="35" VerticalAlignment="Top"
                                        ColumnDefinitions="*,100,5,auto,5,auto,100,20">
                                        <controls:MyButton Text="立即刷新" Grid.Column="1"/>
                                        <TextBlock Text="刷新间隔" VerticalAlignment="Center" Grid.Column="3"/>
                                        <ComboBox SelectedIndex="0" Grid.Column="5" VerticalAlignment="Center">
                                            <ComboBoxItem Content="1s"/>
                                            <ComboBoxItem Content="3s"/>
                                            <ComboBoxItem Content="5s"/>
                                        </ComboBox>
                                        <controls:MyButton Text="重置视图" Click="ResetChartZoom_Click" Grid.Column="6"/>
                                    </Grid>
                                    <Grid RowDefinitions="5,160,160,*,5"
                                        ColumnDefinitions="5,80,*,20"
                                        ShowGridLines="True" Margin="0,35,0,0">
                                        <TextBlock Text="CPU占用率" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1"/>
                                        <lvc:CartesianChart LegendPosition="Right" ZoomMode="ZoomX" Name="CPUChart" Grid.Row="1" Grid.Column="2">  
                                            <lvc:CartesianChart.XAxes>
                                            <!-- DateTime 专用轴 -->
                                            <lvc:XamlDateTimeAxis Interval="00:00:01" DateFormatter="{Binding DateFormatter}" />
                                            </lvc:CartesianChart.XAxes>

                                            <lvc:CartesianChart.YAxes>
                                                <!-- 百分比 Y 轴 -->
                                                <lvc:XamlAxis Labeler="{Binding PercentLabeler}" MinLimit="0" MaxLimit="100" />
                                            </lvc:CartesianChart.YAxes>
                                        </lvc:CartesianChart>
                                        <TextBlock Text="内存" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"/>
                                        <lvc:CartesianChart LegendPosition="Right" ZoomMode="ZoomX" Name="MemoryChart" Grid.Row="2" Grid.Column="2">  
                                            <lvc:CartesianChart.XAxes>
                                            <!-- DateTime 专用轴 -->
                                            <lvc:XamlDateTimeAxis Interval="00:00:01" DateFormatter="{Binding DateFormatter}" />
                                            </lvc:CartesianChart.XAxes>

                                            <lvc:CartesianChart.YAxes>
                                                <!-- 内存占用量 Y 轴（GB） -->
                                                <lvc:XamlAxis Labeler="{Binding MemoryLabeler}" MinLimit="0" MaxLimit="{Binding TotalMemory}" />
                                            </lvc:CartesianChart.YAxes>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Panel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <TabItem Header="后端" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/><!--进程占用、退出按钮-->

                            </Panel>
                        </TabItem>
                    </TabControl>

                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="120">
                        <TextBlock Classes="fir" Text="所有管理器"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Store.png"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <ListBox SelectedItem="{Binding SelectedMCServerManagerConfig_LBItem}" ItemsSource="{Binding AllMCServerManagers_IS}" Margin="7,5,110,5"  Background="Transparent" BorderThickness="0" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:MCServerManagerConfig_LBItem ManagerID="{Binding ManagerID}" ServerName="{Binding ServerName}" MCServerType="{Binding MCServerType}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="2,3,2,3"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                    <Line StartPoint="0,0" EndPoint="0,1" Stretch="Fill" Stroke="gray" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,106,0"/>
                    <StackPanel Spacing="3" Width="106" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="操作" HorizontalAlignment="Center"/>
                        <controls:MyButton Text="刷新" Command="{Binding RefreshAllMCServerManagerListCommand}"/>
                        <controls:MyButton Text="新建" Command="{Binding CreateNewMCServerManagerCommand}"/>
                        <controls:MyButton Text="启动" Command="{Binding LoadNewMCServerManagerCommand}"/>
                        <controls:MyButton Text="停止" Command="{Binding StopNewMCServerManagerCommand}"/>
                        <controls:MyButton Text="删除" Command="{Binding DeleteMCServerManagerCommand}"/>
                        <controls:MyButton Text="保存" Command="{Binding SaveCiphertextConfigCommand}"/>
                        <StackPanel.Styles>
                            <Style Selector="controls|MyButton">
                                <Setter Property="Width" Value="100"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="CornerRadius" Value="1"/>
                            </Style>
                        </StackPanel.Styles>
                    </StackPanel>
                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="160">
                        <TextBlock Classes="fir" Text="运行中的管理器"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Machine.png"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <ListBox SelectedItem="{Binding SelectedMCServerManager_LBItem}" ItemsSource="{Binding LoadedMCServerManagers_IS}" Margin="7,5,110,5"  Background="Transparent" BorderThickness="0" BorderBrush="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:MCServerManager_LBItem ManagerID="{Binding ManagerID}" ServerName="{Binding ServerName}" MCServerType="{Binding MCServerType}" MCServerRunningState="{Binding MCServerRunningState}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="2,3,2,3"/>
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                    <Line StartPoint="0,0" EndPoint="0,1" Stretch="Fill" Stroke="gray" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,106,0"/>
                    <StackPanel Spacing="3" Width="106" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="操作" HorizontalAlignment="Center"/>
                        <controls:MyButton Text="刷新" Command="{Binding RefreshLoadedMCServerManagerCommand}"/>
                        <controls:MyButton Text="打开" Command="{Binding OpenSelectedMCServerManagerCommand}"/>
                        <controls:MyButton Text="保存" Command="{Binding SaveCiphertextConfigCommand}"/>
                        <StackPanel.Styles>
                            <Style Selector="controls|MyButton">
                                <Setter Property="Width" Value="100"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="CornerRadius" Value="1"/>
                            </Style>
                        </StackPanel.Styles>
                    </StackPanel>
                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="80">
                        <TextBlock Classes="fir" Text="工具箱"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Tools.png"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <TabControl Classes="sec">
                        <TabItem Header="暂时没有哦" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                    </TabControl>
                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="60">
                        <TextBlock Classes="fir" Text="设置"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Settings.png"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <TabControl Classes="sec">
                        <TabItem Header="暂时没有哦" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                    </TabControl>
                </Panel>
            </TabItem>
            <TabItem Classes="fir">
                <TabItem.Header>
                    <Panel Width="60">
                        <TextBlock Classes="fir" Text="关于"/>
                        <Image Classes="fir" Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/About.png"/>
                    </Panel>
                </TabItem.Header>
                <Panel>
                    <Line Classes="fir"/>
                    <TabControl Classes="sec">
                        <TabItem Header="软件信息" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="更新日志" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                        <TabItem Header="引用清单" Classes="sec">
                            <Panel>
                                <Line Classes="sec"/>
                            </Panel>
                        </TabItem>
                    </TabControl>
                </Panel>
            </TabItem>
            <TabControl.Styles>
                <Style Selector="TabItem.fir">
                    <Setter Property="Padding" Value="5,0,5,0"/>
                    <Setter Property="FontSize" Value="20"/>
                </Style>
                <Style Selector="TextBlock.fir">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="20"/>
                </Style>
                <Style Selector="Image.fir">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Height" Value="18"/>
                </Style>
                <Style Selector="Line.fir">
                    <Setter Property="StartPoint" Value="0,0"/>
                    <Setter Property="EndPoint" Value="1,0"/>
                    <Setter Property="Stretch" Value="Fill"/>
                    <Setter Property="Stroke" Value="gray"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Style>
                <Style Selector="TabControl.sec">
                    <Setter Property="Margin" Value="0,2,0,0"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="TabStripPlacement" Value="Left"/>
                </Style>
                <Style Selector="TabItem.sec">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="1,0,0,0"/>
                </Style>
                <Style Selector="Line.sec">
                    <Setter Property="StartPoint" Value="0,0"/>
                    <Setter Property="EndPoint" Value="0,1"/>
                    <Setter Property="Stretch" Value="Fill"/>
                    <Setter Property="Stroke" Value="gray"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                </Style>
                <Style Selector="Panel.sec">
                    <Setter Property="Margin" Value="2,0,0,0"/>
                </Style>
            </TabControl.Styles>
        </TabControl>
        <!--叠加层-->
        <Panel Background="#FDFDFD" Classes="MCServerManager" IsVisible="{Binding MCServerManagerPanelVisibility}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding MCServerName}" HorizontalAlignment="Left" FontSize="16"/>
            <TextBlock Text="日志轮询间隔" HorizontalAlignment="Right" Margin="0,0,230,0" FontSize="16"/>
            <Slider Value="{Binding ServerLogsAskInterval}" Minimum="50" Maximum="10000" Margin="0,-13,26,0" Height="35" Width="200" HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Line StartPoint="0,0" EndPoint="1,0" Margin="0,25,0,0" Stroke="LightGray" Stretch="Fill" StrokeThickness="2"/>
            <DrawerPage DataContext="{Binding #root.DataContext}" Background="#89C2FF" CompactDrawerLength="26" DrawerPlacement="Right" DrawerLength="160" DrawerLayoutBehavior="CompactOverlay" Margin="0,27,0,0">
                <DrawerPage.Drawer>
                    <ScrollViewer>
                        <StackPanel DataContext="{Binding #root.DataContext}">
                            <Button Command="{Binding ChangePageCommand}" CommandParameter="Console">
                                <Panel>
                                    <Image Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Console.png"/>
                                    <TextBlock Text="控制台"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ChangePageCommand}" CommandParameter="Backup">
                                <Panel>
                                    <Image Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Store.png"/>
                                    <TextBlock Text="备份"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ChangePageCommand}" CommandParameter="OnlineChatting">
                                <Panel>
                                    <Image Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Link.png"/>
                                    <TextBlock Text="互联"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ChangePageCommand}" CommandParameter="Explorer">
                                <Panel>
                                    <Image Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Folder.png"/>
                                    <TextBlock Text="文件管理"/>
                                </Panel>
                            </Button>
                            <Button Command="{Binding ChangePageCommand}" CommandParameter="Settings">
                                <Panel>
                                    <Image Source="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Settings.png"/>
                                    <TextBlock Text="设置"/>
                                </Panel>
                            </Button>
                            <StackPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="26"/>
                                    <Setter Property="Padding" Value="1"/>
                                </Style>
                                <Style Selector="Image">
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                </Style>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="26,0,0,0"/>
                                </Style>
                            </StackPanel.Styles>
                        </StackPanel>
                    </ScrollViewer>
                </DrawerPage.Drawer>
                <DrawerPage.DrawerFooter>
                    <controls:MyButton Command="{Binding ExitManagerPanelCommand}" Height="45" Text="返回" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/ExitApp.png"/>
                </DrawerPage.DrawerFooter>
                <Panel DataContext="{Binding #root.DataContext}">
                    <Grid IsVisible="{Binding ConsolePanelVisibility}" Background="#FFFFF0" RowDefinitions="2,*,2,30,2" ColumnDefinitions="2,*,2,30,2,30,2,30,2,30,2,30,2">
                        <!-- 控制台-->
                        <avaloniaedit:TextEditor Name="ServerLogsShower" Document="{Binding ServerLogsDocument}"
                                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                                                 Grid.Row="1" Grid.Column="1" Background="#FFFFF0" BorderThickness="2"
                                                 BorderBrush="LightGray" Grid.ColumnSpan="11" ShowLineNumbers="True"
                                                 IsReadOnly="True">
                        </avaloniaedit:TextEditor>
                        <AutoCompleteBox ItemsSource="{Binding CommandsSupport_IS}" Text="{Binding Command}" Grid.Row="3" Grid.Column="1" PlaceholderText="键入命令（无需/）"/>
                        <controls:ImageButton Command="{Binding SendCommandCommand}" Grid.Row="3" Grid.Column="3" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Send.png"/>
                        <controls:ImageButton Command="{Binding GetOlderLogsCommand}" Name="GetOlderLogsButton" Grid.Row="3" Grid.Column="5" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Store.png"/>
                        <controls:ImageButton Command="{Binding RunMCServerCommand}" Grid.Row="3" Grid.Column="7" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Run.png"/>
                        <controls:ImageButton Command="{Binding StopMCServerCommand}" Grid.Row="3" Grid.Column="9" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Shutdown.png"/>
                        <controls:ImageButton Command="{Binding KillMCServerCommand}" Grid.Row="3" Grid.Column="11" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/KillMCServer.png"/>
                    </Grid>
                    <ScrollViewer IsVisible="{Binding SettingPanelVisibility}">
                        <StackPanel IsVisible="{Binding SettingPanelVisibility}" Background="#FFFFF0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <!-- 配置页-->
                            <TextBlock Text="管理器配置" HorizontalAlignment="Center" FontSize="20"/>
                            <TextBlock Text="服务器名称:"/>
                            <TextBox Text="{Binding MCServerName_Edit}" PlaceholderText="例如：机械动力服——二周目" IsEnabled="{Binding EditingConfig}"/>
                            <TextBlock Text="服务端类型:"/>
                            <ComboBox Text="{Binding MCServerType_Edit}" IsEditable="true" PlaceholderForeground="LightGray" IsEnabled="{Binding EditingConfig}" PlaceholderText="选择一个类型，不在支持列表中请选“Vanilla”" HorizontalAlignment="Stretch" DataContext="{Binding #root.DataContext}" ItemsSource="{Binding SupportedMCServerTypes_IS}"/>
                            <TextBlock Text="服务端根目录:"/>
                            <TextBox Text="{Binding MCServerDirectory_Edit}" PlaceholderText="请输入绝对路径" IsEnabled="{Binding EditingConfig}"/>
                            <TextBlock Text="Java路径:"/>
                            <TextBox Text="{Binding JavaPath_Edit}" IsEnabled="{Binding EditingConfig}"/>
                            <TextBlock Text="启动参数:"/>
                            <TextBox Text="{Binding StartArgument_Edit}" IsEnabled="{Binding EditingConfig}"/>
                            <Line Margin="0,10" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="LightGray" StrokeThickness="2"/>
                            <TextBlock Text="备份工具配置" HorizontalAlignment="Center" FontSize="20"/>
                            <TextBlock Text="启用自动备份"/>
                            <CheckBox IsEnabled="{Binding EditingConfig}"/>
                            <Line Margin="0,10" StartPoint="0,0" EndPoint="1,0" Stretch="Fill" Stroke="LightGray" StrokeThickness="2"/>
                            <TextBlock Text="互联系统配置" HorizontalAlignment="Center" FontSize="20"/>
                            <TextBlock Text="启用"/>
                            <CheckBox IsEnabled="{Binding EditingConfig}"/>
                            <controls:MyButton Command="{Binding EditConfigCommand}" HorizontalAlignment="Right" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Set.png" MaxHeight="50" MaxWidth="120" Text="修改配置"/>
                            <controls:MyButton Command="{Binding CommitConfigCommand}" HorizontalAlignment="Right" Image="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Finish.png" MaxHeight="50" MaxWidth="120" Text="提交配置"/>
                            <StackPanel.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="15"/>
                                </Style>
                            </StackPanel.Styles>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </DrawerPage>
        </Panel>
        <ListBox ItemsSource="{Binding Messages_IS}" MaxHeight="260" Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Left"><!--消息列表-->
        <ListBox.ItemTemplate>
            <DataTemplate>
                <controls:Message MessageString="{Binding Message}" Background="{Binding Color}"/>
            </DataTemplate>
        </ListBox.ItemTemplate>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0,1,0,1"/>
                </Style>
            </ListBox.Styles>
        </ListBox>
        <controls:ImageButton Command="{Binding CleanMessageCommand}" Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Right" Image_IB="avares://PMCSsE_Frontend_AvaloniaUI/Icons/Clean.png"/>

    </Panel>

</UserControl>
