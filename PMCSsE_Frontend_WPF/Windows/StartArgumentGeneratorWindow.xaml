<Window x:Class="PMCSsE_Frontend_WPF.Windows.StartArgumentGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d"
        Title="StartArgumentGeneratorWindow"
        Height="576"
        Width="1024" FontSize="20" Closing="Window_Closing" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <!--窗口框架-->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#50000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="WindowTitleTextBlock" Grid.Column="1" Text="PMCSsE--启动参数生成器" FontSize="16" Foreground="White" 
                       VerticalAlignment="Center"/>
            <Thumb Grid.ColumnSpan="4" Margin="5,5,5,0" Background="Transparent" Opacity="0" Cursor="SizeAll"
                   MouseDoubleClick="Thumb_MouseDoubleClick" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="RightToLeft">
                <local:ImageButton Width="24" Margin="8" Click="Close_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Close.png" Style="{StaticResource ImageButtonStyle1}"/>
                <local:ImageButton Width="24" Margin="8"  Click="Maximize_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Maximize.png" Style="{StaticResource ImageButtonStyle2}"/>
                <local:ImageButton Width="24" Margin="8" Click="Minimize_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Minimize.png" Style="{StaticResource ImageButtonStyle2}"/>
            </StackPanel>
        </Grid>
        <Thumb Grid.Row="0" Grid.Column="0" Background="Transparent" Opacity="0" Cursor="SizeNWSE"/>
        <Thumb Grid.Row="0" Grid.Column="1" Background="Transparent" Opacity="0" Cursor="SizeNS"/>
        <Thumb Grid.Row="0" Grid.Column="2" Background="Transparent" Opacity="0" Cursor="SizeNESW"/>
        <Thumb Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Background="Transparent" Opacity="0" Cursor="SizeWE"/>
        <Thumb Grid.Row="3" Grid.Column="2" Background="Transparent" Opacity="0" Cursor="SizeNWSE"/>
        <Thumb Grid.Row="3" Grid.Column="1" Background="Transparent" Opacity="0" Cursor="SizeNS"/>
        <Thumb Grid.Row="3" Grid.Column="0" Background="Transparent" Opacity="0" Cursor="SizeNESW"/>
        <Thumb Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Background="Transparent" Opacity="0" Cursor="SizeWE"/>

        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="30" Text="启动参数生成器" Margin="40,0,0,15"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="分配的内存: "/>
                <TextBlock x:Name="MemoryTextBlock" Text="4096"/>
                <TextBlock Text=" MB"/>
            </StackPanel>
            <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Slider Grid.Row="0" Name="MemorySlider" ValueChanged="MemorySlider_ValueChanged" Minimum="1" Maximum="16384" Value="4096" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <Border Grid.Row="1" Margin="0,8,0,0" Height="9" CornerRadius="2" BorderBrush="#DD000000" BorderThickness="0.7">
                    <Grid Name="MemoryShowerGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="UsedMemoryCol"/>
                            <ColumnDefinition x:Name="WillBeUsedMemoryCol"/>
                            <ColumnDefinition x:Name="LastMemoryCol"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#FF0098E8"/>
                        <Rectangle Grid.Column="1" x:Name="WillBeMemoryRec" Fill="#993AD0E4"/>
                        <Rectangle Grid.Column="2" x:Name="LastMemoryRec" Fill="#303AD0E4"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="28" Margin="5,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="服务端核心文件路径: "/>
                <TextBox Grid.Column="1" Text="Server.jar" Name="FileNameTextBox" TextChanged="FileNameTextBox_TextChanged"/>
                <local:ImageButton Grid.Column="2" Style="{StaticResource ImageButtonStyle}" Click="ChooseFileButton_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Folder.png"/>
            </Grid>
            <DockPanel Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2" Margin="10,0,5,0">
                <TextBlock Text="参数预设:" DockPanel.Dock="Left"/>
                <ComboBox x:Name="ArgTypeComboBox" DockPanel.Dock="Right" SelectedIndex="0" SelectionChanged="ArgTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Aikar's(可优化JVM)"/>
                    <ComboBoxItem Content="基本(正常控制台输出)"/>
                    <ComboBoxItem Content="最简"/>
                    <ComboBoxItem Content="Velocity"/>
                </ComboBox>
            </DockPanel>
            <CheckBox Grid.Row="5" Grid.Column="5" Content="显示服务端自带GUI" VerticalAlignment="Center" Name="ShowGUICheckBox" Checked="ShowGUICheckBox_Checked" Unchecked="ShowGUICheckBox_Checked"/>
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="5" Name="ArgTextBox" TextWrapping="Wrap" Margin="0,0,0,15" FontSize="16"/>
            <local:CustomButton Grid.Row="8" Grid.Column="4" Margin="0,0,5,0" Style="{StaticResource BlueCustomButtonStyle}" CustomButtonText="应用参数" Click="CustomButton_Click_1" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Finish.png"/>
            <local:CustomButton Grid.Row="8" Grid.Column="5" Margin="5,0,0,0" Style="{StaticResource BlueCustomButtonStyle}" CustomButtonText="取消" Click="CustomButton_Click_2" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Cancel.png"/>
        </Grid>
    </Grid>
</Window>
