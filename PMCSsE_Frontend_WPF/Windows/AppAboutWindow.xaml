<localWin:CustomWindow x:Class="PMCSsE_Frontend_WPF.Windows.AppAboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localWin="clr-namespace:PMCSsE_Frontend_WPF.Windows"
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d"
        Title="关于此应用" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="25"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="关于本应用" Grid.Row="1" Grid.Column="1" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Border Grid.Row="2" Grid.Column="1" BorderBrush="#336699" BorderThickness="5" CornerRadius="10" Margin="10,10,10,10">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="应用名称: Prime Minecraft Servers Engine Frontend  简称:PMCSsE_Frontend" FontSize="17" Margin="5"/>
                    <TextBlock Text="版 本 号: 1.0.4.0" FontSize="17" Margin="5"/>
                    <TextBlock Text="作    者: 八宝粥" FontSize="17" Margin="5"/>
                    <Grid Margin="5" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="8*"/>
                            <ColumnDefinition Width="10*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="项目地址(打不开时请科学上网)：" FontSize="17" VerticalAlignment="Center"/>
                        <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Click="CustomButton_Click" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_OpenWebsite.png" CustomButtonBorderThickness="2" CustomButtonText="打开项目网址" Grid.Column="1" Margin="5,0,0,0"/>
                    </Grid>
                    <GroupBox BorderThickness="3" BorderBrush="LightSkyBlue" Header="应用简介:" FontSize="17" Margin="5">
                        <StackPanel>
                            <TextBlock xml:space="preserve" TextWrapping="Wrap" FontSize="16" Margin="5">一个用于管理Minecraft服务端的应用程序，旨在为各种作操提供便捷的界面。</TextBlock>
                        </StackPanel>
                    </GroupBox>
                    <!--更新日志-->
                    <GroupBox BorderThickness="3" BorderBrush="LightSkyBlue" Header="更新日志:" FontSize="16" Margin="5">
                        <StackPanel>
                            <TextBlock xml:space="preserve" TextWrapping="Wrap" Margin="5">V1.0.4.0: 项目彻底重构，前后端分离
V1.0.4.0以前:早期版本非常糟糕，就不记录了</TextBlock>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</localWin:CustomWindow>
