                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" x:Name="ShutdownButton_BG" IsEnabled="False" Grid.Column="4" Click="ShutdownButton_BG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_ShutdownMCServer.png"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" x:Name="KillButton_BG" IsEnabled="False" Grid.Column="6" Click="KillButton_BG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_KillMCServer.png"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" Grid.Column="8" Click="OpenSettingsWindowButton_BG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Settings1.png"/>
                </Grid>
                <Line Grid.Column="3" HorizontalAlignment="Left" Stroke="DarkGray" StrokeThickness="3" Y1="0" Y2="1" Stretch="Fill" Margin="0,-1.5,0,-1.5"/>
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Name="ShowTimeCheckBox_BG" Click="ShowTimeCheckBox_BG_Click" Content="显示日志时间" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="True"/>
                    <CheckBox Grid.Column="1" Name="ShowDebugLogCheckBox_BG" Click="ShowDebugLogCheckBox_BG_Click" Content="显示调试日志" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="False"/>
                    <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Click="CleanLogButton_Click" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Clean.png" Grid.Column="2" CustomButtonBorderCornerRadius="8" CustomButtonBorderThickness="2" CustomButtonText="清空日志"/>
                </Grid>
                <Line Grid.Column="3" HorizontalAlignment="Right" Stroke="DarkGray" StrokeThickness="3" Y1="0" Y2="1" Stretch="Fill" Margin="0,-1.5,0,-1.5"/>
                <Line Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Stretch="Fill" Stroke="DarkGray" Opacity="0.8" X1="0" X2="1" StrokeThickness="3" Margin="-1.5,0,-1.5,0"/>

                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5"/>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="5"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Row="1" Grid.Column="1" x:Name="LogListBox_BG" FontSize="15" ScrollViewer.CanContentScroll="True" BorderBrush="Transparent" BorderThickness="0"
            ScrollViewer.IsDeferredScrollingEnabled="False" VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling" Background="Transparent">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <local:LogListBoxItem DataContext="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Line Grid.Row="2" Grid.Column="0" Y1="0" Y2="1" Stretch="Fill" Stroke="LightGray" StrokeThickness="3" HorizontalAlignment="Right" Margin="0,-1.5,0,-1.5"/>
                    <Line Grid.Row="2" Grid.Column="3" Y1="0" Y2="1" Stretch="Fill" Stroke="LightGray" StrokeThickness="3" HorizontalAlignment="Left" Margin="0,-1.5,0,-1.5"/>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="LightGray" StrokeThickness="3" Margin="-1.5,0,-1.5,0"/>
                        <TextBlock Name="MainTaskTextBlock" Text=" 进行中的主任务:" Margin="0,2,0,2"/>
                        <ProgressBar Name="MainTaskProgressBar" Grid.Row="3" Grid.Column="1" Height="5" Background="Transparent" BorderBrush="Transparent"/>
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="LightGray" StrokeThickness="3" Margin="-1.5,0,-1.5,0"/>
                        <TextBlock Name="SecondaryTaskTextBlock" Text=" 进行中的分任务:" Margin="0,2,0,2"/>
                        <ProgressBar Name="SecondaryTaskProgressBar" Grid.Row="3" Grid.Column="1" Height="5" Background="Transparent" BorderBrush="Transparent"/>
                        <Line X1="0" X2="1" Stretch="Fill" Stroke="LightGray" StrokeThickness="3" Margin="-1.5,0,-1.5,0"/>

                    </StackPanel>
                </Grid>
                
                <StackPanel MaxWidth="200" Grid.Row="2" Grid.Column="4" Name="FunctionCollectionList_BG"/>
            </Grid>
            <Grid Grid.Row="2" Name="OnlineChatAndManagerConsoleGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="201"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" FontSize="17" Name="ManagerIDAndName_OG" Text="ID-服务器名称  当前页面:实时服内外通信与管理工具" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Line Grid.Column="1" HorizontalAlignment="Right" Stroke="DarkGray" StrokeThickness="3" Y1="0" Y2="1" Stretch="Fill" Margin="0,-1.5,0,-1.5"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="8*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text=" 服务端操作: " VerticalAlignment="Center" Height="20"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" Grid.Column="2" x:Name="StartButton_OG" Click="StartButton_OG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_RunMCServer.png"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" x:Name="ShutdownButton_OG" IsEnabled="False" Grid.Column="4" Click="ShutdownButton_OG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_ShutdownMCServer.png"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" x:Name="KillButton_OG" IsEnabled="False" Grid.Column="6" Click="KillButton_OG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_KillMCServer.png"/>
                    <local:ImageButton Style="{StaticResource ImageButtonStyle}" Grid.Row="1" Grid.Column="8" Click="OpenSettingsWindowButton_OG_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Settings1.png"/>
                </Grid>
                <Line Grid.Column="3" HorizontalAlignment="Left" Stroke="DarkGray" StrokeThickness="3" Y1="0" Y2="1" Stretch="Fill" Margin="0,-1.5,0,-1.5"/>
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Name="ShowTimeCheckBox_OG" Click="ShowTimeCheckBox_OG_Click" Content="显示日志时间" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="True"/>
                    <CheckBox Grid.Column="1" Name="ShowDebugLogCheckBox_OG" Click="ShowDebugLogCheckBox_OG_Click" Content="显示调试日志" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="False"/>
                    <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Click="CleanLogButton_Click" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Clean.png" Grid.Column="2" CustomButtonBorderCornerRadius="8" CustomButtonBorderThickness="2" CustomButtonText="清空日志"/>
                </Grid>
                <Line Grid.Column="3" HorizontalAlignment="Right" Stroke="DarkGray" StrokeThickness="3" Y1="0" Y2="1" Stretch="Fill" Margin="0,-1.5,0,-1.5"/>
                <Line Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Stretch="Fill" Stroke="DarkGray" Opacity="0.8" X1="0" X2="1" StrokeThickness="3" Margin="-1.5,0,-1.5,0"/>
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5"/>
                        <RowDefinition/>
                        <RowDefinition Height="2"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="5"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Row="1" Grid.Column="1" x:Name="LogListBox_OG" FontSize="15" ScrollViewer.CanContentScroll="True" BorderBrush="Transparent" BorderThickness="0"
            ScrollViewer.IsDeferredScrollingEnabled="False" VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling" Background="Transparent">
                        <ListBox.ItemsPanel>
