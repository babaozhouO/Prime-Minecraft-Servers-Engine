<Window x:Class="PMCSsE_Frontend_WPF.Windows.AddNewMCServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d"
        Closing="Window_Closing"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Title="添加新的MC服务端管理器"
        Height="576"
        Width="1024"
        FontSize="16">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35"/>
            <RowDefinition/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <!--窗口框架-->
        <Grid Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#50000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Name="WindowTitleTextBlock" Grid.Column="1" Text="PMCSsE--添加新的MC服务端管理器" FontSize="16" Foreground="White" 
                       VerticalAlignment="Center"/>
            <Thumb Grid.ColumnSpan="4" Margin="5,5,5,0" Background="Transparent" Opacity="0" Cursor="SizeAll"
                   MouseDoubleClick="Thumb_MouseDoubleClick" DragDelta="Thumb_DragDelta" DragCompleted="Thumb_DragCompleted"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="RightToLeft">
                <local:ImageButton Width="24" Margin="8" Click="Close_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Close.png" Style="{StaticResource ImageButtonStyle1}"/>
                <local:ImageButton Width="24" Margin="8"  Click="Maximize_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Maximize.png" Style="{StaticResource ImageButtonStyle2}"/>
                <local:ImageButton Width="24" Margin="8" Click="Minimize_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Minimize.png" Style="{StaticResource ImageButtonStyle2}"/>
            </StackPanel>
        </Grid>
        <Thumb Grid.Row="0" Grid.Column="0" Background="Transparent" Opacity="0" Cursor="SizeNWSE"/>
        <Thumb Grid.Row="0" Grid.Column="1" Background="Transparent" Opacity="0" Cursor="SizeNS"/>
        <Thumb Grid.Row="0" Grid.Column="2" Background="Transparent" Opacity="0" Cursor="SizeNESW"/>
        <Thumb Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Background="Transparent" Opacity="0" Cursor="SizeWE"/>
        <Thumb Grid.Row="3" Grid.Column="2" Background="Transparent" Opacity="0" Cursor="SizeNWSE"/>
        <Thumb Grid.Row="3" Grid.Column="1" Background="Transparent" Opacity="0" Cursor="SizeNS"/>
        <Thumb Grid.Row="3" Grid.Column="0" Background="Transparent" Opacity="0" Cursor="SizeNESW"/>
        <Thumb Grid.Row="1" Grid.Column="0" Grid.RowSpan="2" Background="Transparent" Opacity="0" Cursor="SizeWE"/>
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="17*"/>
                <RowDefinition Height="29*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="22*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="27*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="22*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="44*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="22*"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="44*"/>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="5*"/>
                <RowDefinition Height="44*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="430*"/>
                <ColumnDefinition Width="15*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="添加新的MC服务端管理器" ToolTip="aaaaaaaaaaaaaaaaaaaaaaa" Grid.Row="1" Grid.Column="1" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="服务器名称:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Name="MCServerNameTextBox" Grid.Row="0" Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="5" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="0.167*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="服务端类型:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox Name="MCServerTypeComboBox" Grid.Row="0" Grid.Column="1" Margin="10,0,5,0" SelectedIndex="0" Height="25" VerticalAlignment="Center">
                    <ComboBoxItem Content="Vanilla"/>
                    <ComboBoxItem Content="Forge"/>
                    <ComboBoxItem Content="Fabric"/>
                    <ComboBoxItem Content="Spigot"/>
                    <ComboBoxItem Content="Bukkit"/>
                    <ComboBoxItem Content="Paper"/>
                    <ComboBoxItem Content="Leaves"/>
                </ComboBox>
                <local:ImageButton Grid.Column="2" Click="ImageButton_Click_2" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_About.png" Style="{StaticResource ImageButtonStyle}"/>
            </Grid>
            <TextBlock Grid.Row="7" Grid.Column="1" Text="服务端目录:" VerticalAlignment="Center"/>
            <Grid Grid.Row="9" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="ImageButton_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Folder.png" Margin="5,0,5,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="ThisMCServerDirectoryTextBox" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
            </Grid>

            <TextBlock Grid.Row="11" Grid.Column="1" Text="Java安装目录下bin文件夹中的javaw.exe的绝对路径 / 环境变量名:"/>
            <Grid Grid.Row="13" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="ImageButton_Click_1" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Folder.png" Margin="5,0,5,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="JavaPathTextBox" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
            </Grid>
            <TextBlock Text="服务端启动参数:" Grid.Row="15" Grid.Column="1"/>
            <Grid Grid.Row="17" Grid.Column="1" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="10*"/>
                </Grid.ColumnDefinitions>
                <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="OpenArgumentGeneratorWindowImageButton_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Generator.png" Margin="5,0,5,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="ThisMCServerStartUpArgumentTextBox" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
            </Grid>
            <Grid Grid.Row="19" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Grid.Row="17" Grid.Column="1" x:Name="AddNewServerButton" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Finish.png" CustomButtonText="完成" Click="AddNewServerButton_Click"/>
                <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Grid.Row="17" Grid.Column="3" x:Name="CancleButton" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Cancel.png" CustomButtonText="取消" Click="CancleButton_Click"/>

            </Grid>
        </Grid>
    </Grid>
</Window>
