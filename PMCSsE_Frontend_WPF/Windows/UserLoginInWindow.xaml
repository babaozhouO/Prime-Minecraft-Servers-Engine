<localWin:CustomWindow x:Class="PMCSsE_Frontend_WPF.Windows.UserLoginInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localWin="clr-namespace:PMCSsE_Frontend_WPF.Windows"
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d"
        Title="PMCSsE——连接到后端"
        Closing="Window_Closing">
    <localWin:CustomWindow.Background>
        <ImageBrush ImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/Image/AppImage_Background1.png"/>
    </localWin:CustomWindow.Background>

    <Border Margin="50,35" Style="{StaticResource AcrylicPanelStyle0.8 0.60}">
        <DockPanel Margin="10,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="连接历史记录" TextAlignment="Center" Margin="0,0,0,3"/>
                <TextBlock DockPanel.Dock="Top" Text="(左键填充，右键删除)" TextAlignment="Center" Margin="0,0,0,3"/>
                <Border Style="{StaticResource AcrylicPanelStyle0.9 0.8}">
                    <ListBox Background="Transparent" Name="History_LB" BorderThickness="3" BorderBrush="Transparent" Width="200" ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Visible" >

                    </ListBox>
                </Border>
            </DockPanel>
            <Line Y1="0" Y2="1" StrokeThickness="3" Stroke="LightGray" Stretch="Fill" Margin="5,-7,5,-7"/>
            <Border Style="{StaticResource AcrylicPanelStyle0.9 0.8}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="27"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="27"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.ColumnSpan="3" Text="连接信息" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    <Line Grid.ColumnSpan="4" Margin="-12,0,-12,0" X1="0" X2="1" Stretch="Fill" StrokeThickness="2" Stroke="LightGray" VerticalAlignment="Bottom"/>

                    <TextBlock Grid.Row="1" Text="主机名:" TextAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="HostName_TB" Background="Transparent" BorderBrush="Transparent"/>
                    <Line Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" X1="0" X2="1" Stretch="Fill" StrokeThickness="2" Stroke="SkyBlue" VerticalAlignment="Bottom"/>

                    <TextBlock Grid.Row="3" Text="端   口:" TextAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="Port_TB" Background="Transparent" BorderBrush="Transparent"/>
                    <Line Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" X1="0" X2="1" Stretch="Fill" StrokeThickness="2" Stroke="SkyBlue" VerticalAlignment="Bottom"/>

                    <TextBlock Grid.Row="5" Text="访问密钥:" TextAlignment="Center"/>
                    <PasswordBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="Password_TB" Background="Transparent" BorderBrush="Transparent"/>
                    <Line Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" X1="0" X2="1" Stretch="Fill" StrokeThickness="2" Stroke="SkyBlue" VerticalAlignment="Bottom"/>
                    <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Name="SavePassword_CB" VerticalAlignment="Top" HorizontalAlignment="Left" Content="记住访问密钥(不推荐)" Margin="5"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="连接日志" Margin="0,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <TextBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Name="LogTextBox" Margin="0,70,0,10" FontSize="15"/>

                    <local:CustomButton Grid.Column="2" Grid.Row="7" x:Name="Connect_btn" Click="Connect_btn_Click" Style="{StaticResource AcrylicCustomButtonStyle}" CustomButtonBorderThickness="3" CustomButtonText="连接" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Login.png"/>
                    <local:CustomButton Grid.Column="2" Grid.Row="7" Visibility="Hidden" x:Name="Verify_btn" Click="Verify_btn_Click" Style="{StaticResource AcrylicCustomButtonStyle}" CustomButtonBorderThickness="3" CustomButtonText="验证密钥指纹" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_Login.png"/>
                    <CheckBox Grid.Column="1" Grid.Row="7" Name="Verify_CB" Content="RSA共钥指纹是否一致" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
            </Border>
        </DockPanel>

    </Border>

</localWin:CustomWindow>
