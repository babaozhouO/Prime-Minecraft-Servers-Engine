<Window x:Class="PMCSsE_Frontend_WPF.Windows.SetSingleMCServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d"
        Title="更改当前管理器的设置"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Height="576"
        Width="1024"
        FontSize="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="22"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="20*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="430*"/>
            <ColumnDefinition Width="15*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="更改当前管理器的设置" Grid.Row="1" Grid.Column="1" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="服务端名称:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox Name="MCServerNameTextBox" Grid.Row="0" Grid.Column="1" Margin="10,0,5,0" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="5" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="0.168*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="服务端类型:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Name="MCServerTypeComboBox" Grid.Row="0" Grid.Column="1" Margin="10,0,5,0" SelectedIndex="0" Height="25" VerticalAlignment="Center">
                <ComboBoxItem Content="Vanilla"/>
                <ComboBoxItem Content="Forge"/>
                <ComboBoxItem Content="Fabric"/>
                <ComboBoxItem Content="Spigot"/>
                <ComboBoxItem Content="Bukkit"/>
                <ComboBoxItem Content="Paper"/>
                <ComboBoxItem Content="Purpur"/>
                <ComboBoxItem Content="Sponge"/>
                <ComboBoxItem Content="Leaves"/>
            </ComboBox>
            <local:ImageButton Grid.Column="2" Click="ImageButton_Click_2" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_About.png" Style="{StaticResource ImageButtonStyle}"/>
        </Grid>
        <TextBlock Grid.Row="7" Grid.Column="1" Text="服务端目录:" VerticalAlignment="Center"/>
        <Grid Grid.Row="9" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="ImageButton_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Folder.png" Margin="5,0,5,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Name="ThisMCServerDirectoryTextBox" TextChanged="ThisMCServerDirectoryTextBox_TextChanged" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
        </Grid>

        <TextBlock Grid.Row="11" Grid.Column="1" Text="Java安装目录下bin文件夹中的javaw.exe的绝对路径 / 环境变量名:"/>
        <Grid Grid.Row="13" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="ImageButton_Click_1" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Folder.png" Margin="5,0,5,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Name="JavaPathTextBox" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
        </Grid>
        <TextBlock Text="服务端启动参数:" Grid.Row="15" Grid.Column="1"/>
        <Grid Grid.Row="17" Grid.Column="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.85*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <local:ImageButton Style="{StaticResource ImageButtonStyle}" Click="OpenPaperArgumentGeneratorImageButton_Click" ImageButtonImageSource="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_OpenWebsite.png" Margin="5,0,5,0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="—>" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Name="ThisMCServerStartUpArgumentTextBox" Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,5,0"/>
        </Grid>
        <Grid Grid.Row="19" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Grid.Row="17" Grid.Column="1" x:Name="AddNewServerButton" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Finish.png" CustomButtonText="完成" Click="SetServerConfigButton_Click"/>
            <local:CustomButton Style="{StaticResource BlueCustomButtonStyle}" Grid.Row="17" Grid.Column="3" x:Name="CancleButton" CustomButtonDisplayImage="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/AppIcon_Cancel.png" CustomButtonText="取消" Click="CancleButton_Click"/>
        </Grid>
    </Grid>
</Window>
