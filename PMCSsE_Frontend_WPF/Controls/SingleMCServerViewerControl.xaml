<UserControl x:Class="PMCSsE_Frontend_WPF.Controls.SingleMCServerViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
             mc:Ignorable="d" 
             Height="180"
             d:DesignWidth="600"
             d:FontSize="18"
             Margin="10,10,10,0">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="200*"/>
            <ColumnDefinition Width="10"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="23"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="23"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="23"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="23"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="100" Grid.ColumnSpan="5" Style="{StaticResource AcrylicPanelStyle0.8 0.60}">
            <DockPanel>
                <DockPanel.Effect>
                    <BlurEffect Radius="5" KernelType="Gaussian" RenderingBias="Quality"/>
                </DockPanel.Effect>
                <Image x:Name="MCServerTypeimage" Stretch="Uniform" Source="pack://application:,,,/PMCSsE_Frontend_WPF;component/Icon/AppIcon_VanillaMCServer.png"/>
                <TextBlock x:Name="MCServerTypeTextBox" FontSize="80" Text="Vanilla" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.6" SpreadMethod="Pad" MappingMode="RelativeToBoundingBox">
                            <GradientStop Color="LimeGreen"/>
                            <GradientStop Color="SaddleBrown" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="5,0,0,0" FontSize="20" Text="MC服务端管理器"/>
        <Line Grid.Row="2" Grid.ColumnSpan="5" Stroke="DarkGray" StrokeThickness="3" X1="0" X2="1" Stretch="Fill"/>
        
        <TextBlock Grid.Row="3" Grid.Column="1" Text="唯一识别码:"/>
        <TextBlock Grid.Row="3" Grid.Column="2" x:Name="ThisServerID" Text="000"/>

        <TextBlock Grid.Row="5" Grid.Column="1" Text="服务器名称:"/>
        <TextBlock Grid.Row="5" Grid.Column="2" x:Name="ThisServerName" Text="我的MC服务器"/>
        
        <TextBlock Grid.Row="7" Grid.Column="1" Text="服务端类型:"/>
        <TextBlock Grid.Row="7" Grid.Column="2" x:Name="ThisServerType" Text="Vanilla"/>
        
        <TextBlock Grid.Row="9" Grid.Column="1" Text="服务端状态:"/>
        <TextBlock Grid.Row="9" Grid.Column="2" x:Name="ThisServerRunningStatu" Text="已停止"/>
    </Grid>
</UserControl>
