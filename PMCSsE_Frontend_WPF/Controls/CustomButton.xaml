<UserControl x:Class="PMCSsE_Frontend_WPF.Controls.CustomButton"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:PMCSsE_Frontend_WPF.Controls"
        mc:Ignorable="d" 
        d:DesignHeight="60"
        d:DesignWidth="200"
        MouseLeftButtonUp="CustomButton_MouseLeftButtonUp"
        MouseLeftButtonDown="CustomButton_MouseLeftButtonDown"
        MouseEnter="CustomButton_MouseEnter"
        MouseLeave="CustomButton_MouseLeave"
        SizeChanged="CustomButton_SizeChanged">
        
    <Grid x:Name="CustomButtonGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="5"/>
            <RowDefinition/>
            <RowDefinition Height="2"/>
            <RowDefinition Height="5"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="5"/>
        </Grid.ColumnDefinitions>
        <Border Grid.RowSpan="4" Grid.ColumnSpan="6" x:Name="CustomButtonBorder" Background="White" CornerRadius="7" BorderBrush="#7DA4C4" BorderThickness="2"/>
        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="CustomButtonTextBlock" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="16" Text="按钮文本"/>
        <Image Grid.Row="1" Grid.Column="2" Stretch="Uniform" Source="pack://application:,,,/PMCSsE_Frontend_WPF;component/icon/Author_BBZ.ico"/>
        <Line x:Name="CustomButtonLine" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" X1="0" X2="1" Stretch="Fill" Stroke="DarkGray" StrokeThickness="2"/>
    </Grid>
</UserControl>
